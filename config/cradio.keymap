#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        to-bt {
            bindings = <&sl 6>;
            key-positions = <20 24>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E       &kp R           &kp T         &kp Y        &kp U        &kp I       &kp O        &kp P
&mt LSHFT A  &mt LCTRL S  &mt LGUI D  &mt LALT F      &kp G         &kp H        &mt RALT J   &mt RGUI K  &mt RCTRL L  &mt RSHIFT SEMI
&kp Z        &kp X        &kp C       &kp V           &kp B         &kp N        &kp M        &kp COMMA   &kp DOT      &kp SLASH
                                      &mt LSHFT LGUI  &lt 1 BSPC    &lt 2 SPACE  &lt 3 ENTER
            >;
        };

        left_layer {
            bindings = <
&kp N1         &kp N2       &kp N3        &kp N4        &kp N5          &trans  &trans   &trans  &trans  &trans
&kp DLLR       &kp RA(SQT)  &kp RA(BSLH)  &kp RA(LBKT)  &kp RA(RBKT)    &trans  &trans   &trans  &trans  &trans
&kp KP_DIVIDE  &kp PLUS     &kp UNDER     &kp RBRC      &kp CARET       &trans  &trans   &trans  &trans  &trans
                                          &trans        &trans          &trans  &kp DEL
            >;
        };

        right_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp N6     &kp N7    &kp N8    &kp N9     &kp N0
&trans  &trans  &trans  &trans  &trans    &kp LEFT   &kp UP    &kp DOWN  &kp RIGHT  &kp BSLH
&trans  &trans  &trans  &trans  &trans    &kp ASTRK  &kp LPAR  &kp EXCL  &kp LBKT   &kp SQT
                        &trans  &trans    &trans     &trans
            >;
        };

        quantums_layer {
            bindings = <
&kp F1        &kp F2   &kp F3      &kp F4           &kp F5                      &kp F6             &kp F7    &kp F8     &kp F9     &kp F10
&kp K_VOL_UP  &kp AT   &kp RA(N3)  &kp TAB          &kp ESC                     &kp MINUS          &to 0     &to 4      &to 5      &none
&kp K_VOL_DN  &kp DQT  &kp RA(N2)  &kp NON_US_BSLH  &kp LS(NON_US_BACKSLASH)    &kp RIGHT_BRACKET  &kp RPAR  &kp PRCNT  &kp EQUAL  &kp RA(GRAVE)
                                   &trans           &trans                      &trans             &none
            >;
        };

        mouse_layer {
            bindings = <
&none      &mkp MCLK    &mkp RCLK      &mkp LCLK     &none           &none           &mkp LCLK     &mkp RCLK       &mkp MCLK        &none
&kp LSHFT  &kp LCTRL    &kp LGUI       &kp LALT      &none           &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none
&kp END    &kp PAGE_UP  &kp PAGE_DOWN  &kp HOME      &none           &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none
                                       &bt BT_SEL 2  &bt BT_SEL 3    &trans          &to 0
            >;
        };

        numpad_layer {
            bindings = <
&none        &none  &none  &none   &none     &kp KP_ASTERISK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS
&sys_reset   &none  &none  &none   &none     &kp KP_DIVIDE    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
&bootloader  &none  &none  &none   &none     &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
                           &trans  &trans    &trans           &to 0
            >;
        };

        bluetooth {
            bindings = <
&bootloader   &trans        &trans        &trans        &trans          &kp GRAVE  &trans  &trans  &trans  &bootloader
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans     &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans     &trans  &trans  &trans  &bt BT_CLR
                                          &trans        &trans          &trans     &trans
            >;
        };
    };
};
